#: modes/webSearch.js:205
#, javascript-format
msgid "Search %s for: \"%s\""
msgstr "Etsi käyttäen %s: \"%s"

#: onboardingmessages.js:3
msgid ""
"Use Super+w (or another shortcut you configured in settings) to start the "
"switcher. Type space separated searches, use the arrow keys to navigate, and "
"press Space to activate."
msgstr ""
"Näppäile Super+w (tai muu asetuksissa säätämäsi pikänäppäin) käynnistääksesi "
"vaihtajan. Kirjoita välilyönnillä eroteltuja hakusanoja, käytä "
"nuolinäppäimiä navigointiin ja paina Enter aktivoidaksesi."

#: onboardingmessages.js:4
msgid "You can also click an item with the mouse/touchpad to activate."
msgstr "Voit myös klikata hiirellä/kosketuslevyllä aktivoidaksesi."

#: onboardingmessages.js:5
msgid ""
"You can use Shift+Enter to bring the activated window to the current "
"workspace."
msgstr ""
"Näppäile Shift+Enter tuodaksesi aktivoidun ikkunan nykyiseen työtilaan."

#: onboardingmessages.js:6
msgid ""
"Use Ctrl+Enter to launch multiple apps or new instances of already open apps"
msgstr ""
"Paina Ctrl+Enter käynnistääksesi monta applikaatiota tai uusia ikkunoita "
"käynnissä olevista applikaatioista"

#: onboardingmessages.js:7
msgid ""
"System settings sections are also available for launching, just search for "
"them!"
msgstr ""
"Järjestelmäasetusten osiot ovat myös laukaistavissa, kirjoita niiden nimiä "
"hakulaatikkoon!"

#: prefs.js:39
msgid "Hotkey to activate switcher"
msgstr "Pikanäppäin vaihtajan aktivoimiseen"

#: prefs.js:45
msgid ""
"There used to be a separate launcher mode, but now launchable apps are shown "
"in the same view"
msgstr ""
"Vaihtajassa oli ennen erillinen käynnistinmoodi, mutta nykyään "
"käynnistettävät applikaatiot näkyvät samassa näkymässä"

#: prefs.js:76
msgid "Use Ctrl+w to toggle on the fly"
msgstr "Paina Ctrl+w vaihtaaksesi lennosta"

#: prefs.js:89
msgid "Show original language names"
msgstr "Näytä alkukieliset nimet"

#: prefs.js:96
msgid "Show executable names"
msgstr "Näytä binäärien nimet"

#: prefs.js:175
msgid "Key"
msgstr "Näppäin"

#: prefs.js:183
msgid "Pattern matching algorithm"
msgstr "Hahmonnusalgoritmi"

#: prefs.js:184
msgid "Strict"
msgstr "Tarkka"

#: prefs.js:184
msgid "Fuzzy"
msgstr "Sumea"

#: prefs.js:196
msgid "Ordering criteria"
msgstr "Järjestys"

#: prefs.js:197
msgid "Last focused"
msgstr "Viimeksi käytetty ensin"

#: prefs.js:197
msgid "Most relevant"
msgstr "Oleellisin ensin"

#: prefs.js:209
msgid "Immediate activation"
msgstr "Välitön aktivointi"

#: prefs.js:214
msgid "When there is just one result, activate immediately"
msgstr "Kun tuloksia on vain yksi, aktivoi välittömästi"

#: prefs.js:232
msgid "Activate immediately this many milliseconds after last keystroke"
msgstr ""
"Aktivoi välittömästi näin monta millisekuntia viimeisen näppäinpainalluksen "
"jälkeen"

#: prefs.js:251
msgid "Icon size (px)"
msgstr "Ikonin koko (px)"

#: prefs.js:269
msgid "Font size (px)"
msgstr "Fonttikoko (px)"

#: prefs.js:287
msgid "Width (%)"
msgstr "Leveys (%)"

#: prefs.js:304
msgid "Activate by pressing a key matching the index in the list"
msgstr "Aktivoi painamalla järjestysnumeroa vastaavaa näppäintä"

#: prefs.js:306
msgid "Disable"
msgstr "Pois käytöstä"

#: prefs.js:306
msgid "Function keys"
msgstr "Funktionäppäimet"

#: prefs.js:306
msgid "Number keys"
msgstr "Numeronäppäimet"

#: prefs.js:334
msgid "Show workspace indicators"
msgstr "Näytä työtilaindikaattori"

#: prefs.js:343
msgid "Show only apps in the current workspace"
msgstr "Näytä vain nykyisellä työpöydällä olevat sovellukset"

#: prefs.js:349
msgid "Fade Effect"
msgstr "Fade-efekti"

#: prefs.js:356
msgid "Show Switcher on active display"
msgstr "Näytä vaihtaja aktiivisella näytöllä"

#: prefs.js:362
msgid "Usage tips"
msgstr "Käyttövinkit"

#: prefs.js:364
msgid "Read all tips"
msgstr "Lue kaikki vinkit"

#: prefs.js:435
msgid "Web Searches"
msgstr "Verkkohaut"

#: prefs.js:436
msgid ""
"Type \"<keyword> <query>\" to search. Example: \"ddg funny cats\" → "
"DuckDuckGo search"
msgstr ""
"Kirjoita \"<avainsana> <haku>\" hakeaksesi. Esimerkiksi: \"ddg hauskoja "
"kissakuvia\" → DuckDuckGo haku"

#: prefs.js:442
msgid "Enable Web Searches"
msgstr "Esimerkki verkkohakuja"

#: prefs.js:469
msgid "Some providers are missing icons."
msgstr "Joiltakin hakumoottoreilta puuttuu ikoneja."

#: prefs.js:476 prefs.js:497
msgid "Fetch All Icons from Google"
msgstr "Hae kaikki ikonit Googlesta"

#: prefs.js:609
msgid "Add"
msgstr "Lisää"

#: prefs.js:616
msgid "Edit"
msgstr "Muokkaa"

#: prefs.js:632
msgid "Delete"
msgstr "Poista"

#: prefs.js:670
msgid "Reset Defaults"
msgstr "Palauta oletusvalinnat"

#: prefs.js:685
msgid "Edit Search Provider"
msgstr "Muokkaa hakumoottoria"

#: prefs.js:685
msgid "Add Search Provider"
msgstr "Lisää hakumoottori"

#: prefs.js:703
msgid ""
"Use {q} in the URL as the placeholder for the search query.\n"
"Example: https://duckduckgo.com/?q={q}"
msgstr ""
"Käytä {q} URLissa merkitsemään paikkaa, mihin hakuehto tulee.\n"
"Esimerkiksi: https://duckduckgo.com/?q={q}"

#: prefs.js:712
msgid "Title"
msgstr "Otsikko"

#: prefs.js:714
msgid "e.g. DuckDuckGo"
msgstr "esimerkiksi DuckDuckGo"

#: prefs.js:720
msgid "URL"
msgstr "URL"

#: prefs.js:722
msgid "https://duckduckgo.com/?q={q}"
msgstr "https://duckduckgo.com/?q={q}"

#: prefs.js:728
msgid "Keyword"
msgstr "Avainsana"

#: prefs.js:730
msgid "e.g. ddg"
msgstr "esimerkiksi ddg"

#: prefs.js:736
msgid "Enabled"
msgstr "Käytössä"

#: prefs.js:746
msgid "Favicon"
msgstr "Favicon"

#: prefs.js:765 prefs.js:796
msgid "Fetch Favicon"
msgstr "Hae Favicon"

#: prefs.js:792
msgid "Fetching favicon…"
msgstr "Faviconia haetaan…"

#: prefs.js:815
msgid "Cancel"
msgstr "Peruuta"

#: prefs.js:819
msgid "Save"
msgstr "Tallenna"

#: prefs.js:828
msgid "<span foreground=\"red\">All fields are required.</span>"
msgstr "<span foreground=\"red\">Kaikki kentät tarvitaan.</span>"

#: prefs.js:832
msgid "<span foreground=\"red\">URL must contain {q} placeholder.</span>"
msgstr ""
"<span foreground=\"red\">URLissa tulee olla {q} merkitsemään hakuehdon "
"paikka.</span>"

#: prefs.js:840
#, javascript-format
msgid "<span foreground=\"red\">Keyword \"%s\" already exists.</span>"
msgstr "<span foreground=\"red\">Avainsana \"%s\" on jo olemassa.</span>"

